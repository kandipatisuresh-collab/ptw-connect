NODE_ENV=development
PORT=3000
# PostgreSQL application connection. Replace the placeholder password locally.
DATABASE_URL=postgresql://sap_fico:change-me@127.0.0.1:5432/permit_to_work
# PostgreSQL administrator connection, used only to create the development role/database.
DATABASE_ADMIN_URL=postgresql://postgres:change-me@localhost:5432/postgres
# Development bootstrap and migrations, enabled by run.sh only after setting valid credentials.
CREATE_DATABASE=true
RUN_DB_MIGRATIONS=true
# Development only. Admin configuration endpoints are blocked in production.
PTW_DEMO_ADMIN_ENABLED=true
OIDC_ISSUER_URL=
OIDC_AUDIENCE=
SAP_BASE_URL=
